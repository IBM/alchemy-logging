{
  "name": "alchemy-logging",
  "version": "0.0.0-REPLACEME",
  "description": "Alchemy Logging implementation in NodeJS/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "NODE_ENV=test nyc mocha --exit --require tsx 'test/**/*.ts'",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "clean": "rm -rf dist",
    "build": "node node_modules/typescript7/bin/tsc",
    "prepare": "npm run build",
    "repl": "tsx"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/alchemy-logging.git"
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts",
      "coverage/**",
      "dist/**",
      "test/**"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "all": true
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Gabe Goodhart",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.0.0",
    "chai": "^6.0.0",
    "deep-equal": "^2.0.5",
    "eslint": "^10.0.0",
    "memory-streams": "^0.1.3",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.0.0",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
