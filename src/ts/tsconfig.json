{
  "declarations": true,
  "compilerOptions": {
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "outDir": "dist",
    "declaration": true,
    "rootDir": "./src",
    "sourceMap": true,
    "lib": [
      "dom",
      "es2017"
    ],
    "types": ["node"],

  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*_test.ts",
    "dist"
  ]
}
